# Admin website settings. NEXT_PUBLIC_* values are baked into the browser bundle at build time - never put a secret here.

# Address of the API (no trailing slash). Locally: http://localhost:4000. On Vercel: the API project's address.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Google sign-in client id (same value as GOOGLE_CLIENT_ID on the API). Unset = no Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
